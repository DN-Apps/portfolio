# Copy this file to .env.local and fill in your values

# Application
NEXT_PUBLIC_APP_NAME=Daniel Portfolio
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email (for contact form)
SMTP_HOST=smtp.ionos.de
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=contactform@portfolio.ned-it.de
SMTP_PASS=your_mailbox_password
SMTP_FROM="Portfolio Kontakt <contactform@portfolio.ned-it.de>"
CONTACT_TO_EMAIL=contactform@portfolio.ned-it.de
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key
TURNSTILE_ENFORCE=true

# Social Links
NEXT_PUBLIC_GITHUB_URL=https://github.com
NEXT_PUBLIC_LINKEDIN_URL=https://linkedin.com
